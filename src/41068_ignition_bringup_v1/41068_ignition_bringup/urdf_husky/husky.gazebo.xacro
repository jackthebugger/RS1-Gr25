<?xml version="1.0"?>
<robot name="husky" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="laser_visual"  default="false" />
  <xacro:arg name="camera_visual" default="false"/>
  <xacro:arg name="imu_visual"    default="false"/>
  <xacro:arg name="gz_model_name" default="husky"/>
  <xacro:property name="gz_model_name" value="$(arg gz_model_name)"/>

  <!-- Sensor performance knobs.
       Ignition renders every camera and lidar on a single sensor thread, so an
       expensive camera directly throttles the lidar. On software-GL machines
       (WSL) a 720x480 RGBD camera starves the lidar to well below 1 Hz, which
       breaks SLAM and the Nav2 costmaps. These arguments let the launch trade
       camera fidelity for the scan rate that navigation depends on. -->
  <xacro:arg name="enable_camera"      default="false"/>
  <xacro:arg name="lidar_update_rate"  default="10"/>
  <xacro:arg name="lidar_samples"      default="360"/>
  <xacro:arg name="camera_update_rate" default="3"/>
  <xacro:arg name="camera_width"       default="720"/>
  <xacro:arg name="camera_height"      default="480"/>
  <xacro:property name="enable_camera" value="$(arg enable_camera)"/>

  <!-- Which Gazebo system drives the base. See the plugin block below. -->
  <xacro:arg name="drive_plugin" default="diff_drive"/>
  <xacro:property name="drive_plugin" value="$(arg drive_plugin)"/>
  <xacro:arg name="effective_wheel_separation" default="0.94"/>

  <xacro:include filename="$(find 41068_ignition_bringup)/urdf_husky/wheel.urdf.xacro"/>

  <gazebo reference="${prefix}imu_link">
    <sensor type="imu" name="imu">
      <always_on>true</always_on>
      <visualize>$(arg imu_visual)</visualize>
      <update_rate>100</update_rate>
      <topic>model/${gz_model_name}/imu</topic>
      <gz_frame_id>${prefix}imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
              <bias_mean>0.0000075</bias_mean>
              <bias_stddev>0.0000008</bias_stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
              <bias_mean>0.0000075</bias_mean>
              <bias_stddev>0.0000008</bias_stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
              <bias_mean>0.0000075</bias_mean>
              <bias_stddev>0.0000008</bias_stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
              <bias_mean>0.1</bias_mean>
              <bias_stddev>0.001</bias_stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
              <bias_mean>0.1</bias_mean>
              <bias_stddev>0.001</bias_stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
              <bias_mean>0.1</bias_mean>
              <bias_stddev>0.001</bias_stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
      <plugin
        filename="ignition-gazebo-imu-system"
        name="ignition::gazebo::systems::Imu">
      </plugin>
    </sensor>
  </gazebo>
 
  <!-- Drive the base.
       DiffDrive commands the four wheel joints, so a turn is produced the way a
       real skid-steer Husky produces one. The alternative, VelocityControl,
       hard-sets the velocity of base_link only; measured on this repository it
       tracks linear commands exactly but achieves just 0.045 rad/s of the
       0.5 rad/s commanded yaw, because the wheel contacts resist a rotation
       that no wheel is turning to create. Nav2 needs rotate-in-place for
       RotateToGoal and for its spin recovery, so DiffDrive is the default.
       Set drive_plugin:=velocity_control to compare. -->
  <xacro:if value="${drive_plugin == 'diff_drive'}">
    <gazebo>
      <plugin
        filename="ignition-gazebo-diff-drive-system"
        name="ignition::gazebo::systems::DiffDrive">
        <left_joint>${prefix}front_left_wheel_joint</left_joint>
        <left_joint>${prefix}rear_left_wheel_joint</left_joint>
        <right_joint>${prefix}front_right_wheel_joint</right_joint>
        <right_joint>${prefix}rear_right_wheel_joint</right_joint>
        <!-- A skid-steer's effective track is wider than its geometric track,
             because turning drags the tyres sideways. Calibrated against the
             measured yaw rate in test/movement_test.py; the geometric value is
             the starting point. -->
        <wheel_separation>$(arg effective_wheel_separation)</wheel_separation>
        <wheel_radius>${wheel_radius}</wheel_radius>
        <topic>model/${gz_model_name}/cmd_vel</topic>
        <!-- DiffDrive also offers odometry, but this model keeps
             OdometryPublisher (below) as the single odometry source. Point
             DiffDrive's own output at unused topics so the two plugins never
             publish to the same place. -->
        <odom_topic>model/${gz_model_name}/diff_drive/odometry</odom_topic>
        <tf_topic>model/${gz_model_name}/diff_drive/tf</tf_topic>
        <frame_id>${prefix}odom</frame_id>
        <child_frame_id>${prefix}base_link</child_frame_id>
        <odom_publish_frequency>1</odom_publish_frequency>
      </plugin>
    </gazebo>
  </xacro:if>

  <xacro:if value="${drive_plugin == 'velocity_control'}">
    <gazebo>
      <plugin
        filename="ignition-gazebo-velocity-control-system"
        name="ignition::gazebo::systems::VelocityControl">
        <topic>model/${gz_model_name}/cmd_vel</topic>
      </plugin>
    </gazebo>
  </xacro:if>

  <!-- Odometry. Differentiates the simulated pose rather than integrating wheel
       encoders, so it does not accumulate the slip error that skid-steering
       creates. The EKF fuses it with the IMU to publish odom->base_link. -->
  <gazebo>
    <plugin
      filename="ignition-gazebo-odometry-publisher-system"
      name="ignition::gazebo::systems::OdometryPublisher">
      <topic>model/${gz_model_name}/odometry</topic>
      <odom_publish_frequency>20</odom_publish_frequency>
      <odom_frame>${prefix}odom</odom_frame>
      <robot_base_frame>${prefix}base_link</robot_base_frame>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin
      filename="ignition-gazebo-joint-state-publisher-system"
      name="ignition::gazebo::systems::JointStatePublisher">
      <topic>model/${gz_model_name}/joint_states</topic>
    </plugin>
  </gazebo>

  <gazebo reference="${prefix}base_scan">
    <sensor type="gpu_lidar" name="lidar">
      <pose relative_to='${prefix}base_scan'>0 0 0 0 0 0</pose>
      <visualize>$(arg laser_visual)</visualize>
      <topic>model/${gz_model_name}/scan</topic>
      <update_rate>$(arg lidar_update_rate)</update_rate>
      <gz_frame_id>${prefix}base_scan</gz_frame_id>
      <ray>
        <scan>
          <horizontal>
            <samples>$(arg lidar_samples)</samples>
            <resolution>1</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>6.28319</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.2</min>
          <max>40</max>
          <resolution>0.015</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <always_on>true</always_on>
    </sensor>
  </gazebo>

  <xacro:if value="${enable_camera}">
  <gazebo reference="${prefix}camera_link">
    <sensor name="rgbd_camera" type="rgbd_camera">
      <camera>
        <horizontal_fov>2.0944</horizontal_fov>
        <image>
          <width>$(arg camera_width)</width>
          <height>$(arg camera_height)</height>
        </image>
        <clip>
          <near>0.1</near>
          <far>40</far>
        </clip>
        <!-- depth_camera near/far clip seems to be ignored for some reason -->
        <!--    We're using Ignition Gazebo Fortress, which uses sdf format 1.9: http://sdformat.org/tutorials?tut=roadmap -->
        <!--    This takes the depth_camera parameter with near / far clip http://sdformat.org/spec?ver=1.4&elem=sensor  -->
        <!-- We also use ign sensors v6 ( run ls | grep libignition-sensors in /usr/lib/x86_64-linux-gnu)-->
        <!-- Looking at the source code, the sdf sets HasDepthCamera() and corresponding HasDepthNearClip() & HasDepthFarClip() which are used in RgbdCameraSensor.cc, so this should work? -->
        <!--    SDF description of Camera: https://github.com/gazebosim/sdformat/blob/sdf9/src/Camera.cc#L598-->
        <!--    Camera sensor source code: https://github.com/gazebosim/gz-sensors/blob/ign-sensors6/src/RgbdCameraSensor.cc#L311  -->
        <depth_camera>
          <clip>
            <near>0.4</near>
            <far>10</far>
          </clip>
        </depth_camera>
      </camera>
      <always_on>1</always_on>
      <update_rate>$(arg camera_update_rate)</update_rate>
      <visualize>$(arg camera_visual)</visualize>
      <topic>/model/${gz_model_name}/camera</topic>
      <gz_frame_id>${prefix}camera_link</gz_frame_id>
    </sensor>
  </gazebo>
  </xacro:if>

</robot>
