<?xml version="1.0"?>
<sdf version="1.7">
  <!-- Vertical wall with real thickness so gpu_lidar / Nav2 can see it.
       Old 0.01 m sheet was effectively invisible to the scan. -->
  <model name="forest_wall">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <pose>0 0 2 0 0 0</pose>
        <geometry>
          <box>
            <size>9.32 0.5 4</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 2 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry>
          <box>
            <size>9.32 0.5 4</size>
          </box>
        </geometry>
        <material>
          <ambient>0.25 0.35 0.20 1</ambient>
          <diffuse>0.35 0.45 0.25 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
