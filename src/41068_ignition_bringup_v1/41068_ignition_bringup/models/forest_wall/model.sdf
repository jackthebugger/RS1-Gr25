<?xml version="1.0"?>
<sdf version="1.7">

  <model name="forest_wall">
    <static>true</static>

    <link name="link">

      <collision name="collision">
        <pose>0 0 2 0 0 0</pose>
        <geometry>
          <box>
            <size>9.32 0.5 4</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <pose>0 0 2 0 0 0</pose>
        <cast_shadows>false</cast_shadows>

        <geometry>
          <box>
            <size>9.32 0.5 4</size>
          </box>
        </geometry>

        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>

          <pbr>
            <metal>
              <albedo_map>materials/textures/forest_wall.png</albedo_map>
              <roughness>1.0</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>

      </visual>

    </link>

  </model>

</sdf>