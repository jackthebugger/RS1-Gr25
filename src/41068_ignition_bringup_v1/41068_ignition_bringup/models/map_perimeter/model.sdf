<?xml version="1.0"?>
<sdf version="1.7">
  <!-- Closed perimeter for flat_custom_ground_plane (60 x 30 m, origin-centred).
       Each segment is a thick box (0.5 m) so gpu_lidar returns hits — thin
       sheets are effectively invisible to the scan. -->
  <model name="map_perimeter">
    <static>true</static>

    <!-- West wall: x = -30, spans full Y -->
    <link name="west">
      <collision name="collision">
        <pose>0 0 2 0 0 0</pose>
        <geometry>
          <box>
            <size>0.5 30 4</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 2 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry>
          <box>
            <size>0.5 30 4</size>
          </box>
        </geometry>
        <material>
          <ambient>0.35 0.30 0.25 1</ambient>
          <diffuse>0.45 0.38 0.30 1</diffuse>
        </material>
      </visual>
      <pose>-30 0 0 0 0 0</pose>
    </link>

    <!-- East wall: x = +30, spans full Y -->
    <link name="east">
      <collision name="collision">
        <pose>0 0 2 0 0 0</pose>
        <geometry>
          <box>
            <size>0.5 30 4</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 2 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry>
          <box>
            <size>0.5 30 4</size>
          </box>
        </geometry>
        <material>
          <ambient>0.35 0.30 0.25 1</ambient>
          <diffuse>0.45 0.38 0.30 1</diffuse>
        </material>
      </visual>
      <pose>30 0 0 0 0 0</pose>
    </link>

    <!-- South wall: y = -15; 61 m long so corners seal against east/west -->
    <link name="south">
      <collision name="collision">
        <pose>0 0 2 0 0 0</pose>
        <geometry>
          <box>
            <size>61 0.5 4</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 2 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry>
          <box>
            <size>61 0.5 4</size>
          </box>
        </geometry>
        <material>
          <ambient>0.35 0.30 0.25 1</ambient>
          <diffuse>0.45 0.38 0.30 1</diffuse>
        </material>
      </visual>
      <pose>0 -15 0 0 0 0</pose>
    </link>

    <!-- North wall: y = +15 -->
    <link name="north">
      <collision name="collision">
        <pose>0 0 2 0 0 0</pose>
        <geometry>
          <box>
            <size>61 0.5 4</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 2 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry>
          <box>
            <size>61 0.5 4</size>
          </box>
        </geometry>
        <material>
          <ambient>0.35 0.30 0.25 1</ambient>
          <diffuse>0.45 0.38 0.30 1</diffuse>
        </material>
      </visual>
      <pose>0 15 0 0 0 0</pose>
    </link>
  </model>
</sdf>
