<?xml version="1.0"?>
<sdf version="1.7">
  <!-- Origin-centred 60 x 60 m heightmap. Z extent 0.65 m (black→0, white→0.65).
       Regenerated by scripts/generate_hilly_heightmap.py from
       models/terrain_sources/01_heightmap_greyscale.png.
       Keep collision and visual size/pos identical (Fortress heightmap quirk). -->
  <model name="hilly_ground">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <heightmap>
            <uri>model://hilly_ground/materials/heights.png</uri>
            <size>60 60 0.65</size>
            <pos>0 0 0</pos>
          </heightmap>
        </geometry>
      </collision>

      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <heightmap>
            <uri>model://hilly_ground/materials/heights.png</uri>
            <size>60 60 0.65</size>
            <pos>0 0 0</pos>
            <texture>
              <diffuse>model://hilly_ground/materials/grass_diffuse.png</diffuse>
              <normal>model://hilly_ground/materials/flat_normal.png</normal>
              <size>60</size>
            </texture>
          </heightmap>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
