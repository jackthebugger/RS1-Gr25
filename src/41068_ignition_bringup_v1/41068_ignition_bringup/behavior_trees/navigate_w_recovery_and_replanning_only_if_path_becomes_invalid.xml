<!--
  RS1-Gr25 / Husky Nav2 BT — route-stable replanning policy.

  Replans the global path ONLY when:
    - the current path becomes collision-invalid (IsPathValid fails), OR
    - the navigation goal is updated (GlobalUpdatedGoal)

  Does NOT replan every second. The stock default
  navigate_to_pose_w_replanning_and_recovery.xml calls ComputePathToPose at
  1 Hz unconditionally; with two forest corridors that caused Path A ↔ Path B
  oscillation whenever Dijkstra briefly preferred the other gap.

  Policy:
    current path valid? → keep following it
    current path invalid? → ComputePathToPose (shortest valid route)

  Entry 021: global ClearEntireCostmap removed. Wiping the global costmap
  erased ObstacleLayer marks and allowed NavFn to re-select an off-FOV Path A
  after Gazebo removal. Global persistence is KeepoutFilter obstacle memory;
  stuck recovery still clears the rolling local costmap only.

  Based on nav2_bt_navigator's navigate_w_recovery_and_replanning_only_if_path_becomes_invalid.xml
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence>
        <RateController hz="1.0" name="RateControllerComputePathToPose">
          <RecoveryNode number_of_retries="1" name="RecoveryComputePathToPose">
            <Fallback name="FallbackComputePathToPose">
              <ReactiveSequence name="CheckIfNewPathNeeded">
                <Inverter>
                  <GlobalUpdatedGoal/>
                </Inverter>
                <IsPathValid path="{path}"/>
              </ReactiveSequence>
              <Sequence name="ComputeAndSmoothPath">
                <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
                <!-- Entry 028: NavFn poses have identity yaw. Humble IsPathValid
                     uses footprintCostAtPose with that yaw when a polygon
                     footprint is set, so a 1.1×0.76 m box at yaw 0 swept
                     trail-bank lethals and forced a 1 Hz replan. SmoothPath
                     writes path orientations for the next IsPathValid tick. -->
                <SmoothPath unsmoothed_path="{path}" smoothed_path="{path}"/>
              </Sequence>
            </Fallback>
            <!-- Local clear only: do not wipe global ObstacleLayer / KeepoutFilter. -->
            <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="RecoveryFollowPath">
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <ClearEntireCostmap name="ClearLocalCostmap-Follow" service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="FallbackRecoveries">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
          <Spin name="SpinRecovery" spin_dist="1.57"/>
          <Wait name="WaitRecovery" wait_duration="5"/>
          <BackUp name="BackUpRecovery" backup_dist="0.30" backup_speed="0.05"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
